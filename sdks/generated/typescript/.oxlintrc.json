{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "test/**/*.mjs"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "src/client-transport.ts",
        "test/mock-server.test.mjs"
      ],
      "rules": {
        "unicorn/no-invalid-fetch-options": "off"
      }
    }
  ]
}
